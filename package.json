{
  "name": "recaller",
  "productName": "Recaller",
  "version": "1.16.0",
  "description": "Your prompts and notes, one click away.",
  "main": "src/main.js",
  "author": "AKhan",
  "license": "MIT",
  "scripts": {
    "start": "node scripts/run-electron.js .",
    "icon": "node scripts/run-electron.js scripts/make-icon.js",
    "icon:mac": "node scripts/run-electron.js scripts/make-icon.js --mac",
    "dist": "electron-builder --win nsis",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win nsis --x64",
    "pack": "electron-builder --dir",
    "test": "npm run test:multicopy && npm run test:update && npm run test:features",
    "test:features": "node scripts/run-electron.js tests/e2e/features.e2e.js",
    "test:update": "node scripts/run-electron.js tests/e2e/update-safety.e2e.js",
    "test:multicopy": "node scripts/run-electron.js tests/e2e/multi-copy.e2e.js",
    "capture": "node scripts/run-electron.js tests/e2e/capture-board.js"
  },
  "build": {
    "appId": "com.akhan.recaller",
    "productName": "Recaller",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon-mac.png",
      "category": "public.app-category.productivity",
      "identity": "-",
      "hardenedRuntime": false,
      "darkModeSupport": true,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Recaller listens only while you dictate a prompt, and sends the recording to OpenAI to turn it into text."
      }
    },
    "dmg": {
      "title": "Recaller ${version}"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Recaller",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  }
}
